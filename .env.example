# تنظیمات اتصال به سرویس هوش مصنوعی ابر آروان (ArvanCloud AIaaS)
# ۱. وارد پنل ابر آروان (panel.arvancloud.ir) شوید -> بخش هوش مصنوعی (AIaaS)
# ۲. نقطه دسترسی (Endpoint) با مدل Gemini-2.5-Flash (یا GPT-4o-mini) بسازید.
# ۳. مقادیر زیر را در فایل .env قرار دهید:

ARVAN_AI_KEY="arvan_api_key_here"
ARVAN_AI_BASE_URL="https://arvancloudai.ir/gateway/models"
ARVAN_AI_MODEL="Gemini-2.5-Flash"
